#!/usr/bin/env python3
#########################################################################################
#
# Judge the normalization test results: show progress, how each measurement is
# distributed, which episodes need a listen (and where in them), and spot-check picks.
#
# Usage: ./report <results-dir> [--url BASE]
#
# Links go to BASE/normalized/<file.mp3> and, for A/B comparison, BASE/<file.mp3>.
# Links to a moment in an episode end in #t=<seconds>, which browsers start playing at.
#
# Safe to run while the tests are still going; it reports on whatever has finished.
# Also writes <results-dir>/report.csv with every measurement and flag per episode.
#
##########################################################################################

import use_venv  # noqa: F401 (must come before the third-party imports)

import argparse
import csv
import os

import numpy as np

from common import natural_key, read_results, timestamp

TARGET_I = -16
DEFAULT_URL = 'https://download.softskills.audio'

# Any one of these flags an episode for a listen
MAX_DURATION_CHANGE = 0.1     # seconds
MAX_LOUDNESS_MISS = 1.0       # LU away from TARGET_I
MAX_TRUE_PEAK = -0.5          # dBTP (the target is -1.5; MP3 encoding overshoots a little)
MIN_FP_SIMILARITY = 0.90      # Whole-episode fingerprint (unrelated audio scores ~0.5)
MIN_FP_CHUNK = 0.80           # Worst 30-second fingerprint chunk
MIN_XCORR_P1 = 0.80           # 1st percentile of 1-second waveform correlations
MAX_XCORR_DROPOUTS = 0        # 1-second windows correlating below 0.5 (missing/garbled audio)
MIN_SILENCE_MATCH = 0.80      # Fraction of pauses found in both versions
MIN_SILENCES = 10             # ... only judged when there are enough pauses to judge
MAX_WER = 0.10                # Fraction of words that differ in a transcribed clip


def judge(p):
    """Reasons to listen, and where"""
    reasons, listen = [], []
    o, n = p['original'], p['normalized']

    change = n['duration'] - o['duration']
    if abs(change) > MAX_DURATION_CHANGE:
        reasons.append(f'duration changed {change:+.2f}s')
        listen.append(min(o['duration'], n['duration']) - 10)
    if n['decode_complaint_count'] > o['decode_complaint_count']:
        reasons.append(f"{n['decode_complaint_count']} decoder errors (original: {o['decode_complaint_count']})")
    if not p['tags']['id3v2_identical']:
        reasons.append('ID3v2 tag changed')
    if not p['tags']['id3v1_identical']:
        reasons.append('ID3v1 tag changed')

    if n['loudness_i'] is None or abs(n['loudness_i'] - TARGET_I) > MAX_LOUDNESS_MISS:
        reasons.append(f"loudness {n['loudness_i']} LUFS")
    if n['true_peak'] is None or n['true_peak'] > MAX_TRUE_PEAK:
        reasons.append(f"true peak {n['true_peak']} dBTP")

    fp = p['fingerprint']
    if fp['similarity'] < MIN_FP_SIMILARITY:
        reasons.append(f"fingerprint similarity {fp['similarity']:.3f}")
    if fp.get('chunk_min', 1) < MIN_FP_CHUNK:
        reasons.append(f"fingerprint chunk {fp['chunk_min']:.3f} at {timestamp(fp['chunk_min_at'])}")
        listen.append(fp['chunk_min_at'])

    x = p['xcorr']
    if x['windows_below_0_5'] > MAX_XCORR_DROPOUTS or x['r_p1'] < MIN_XCORR_P1:
        reasons.append(f"waveform: {x['windows_below_0_5']} seconds don't match, "
                       f"1st percentile r={x['r_p1']:.3f}")
        regions = x.get('mismatch_regions') or [[w['at'], w['at'] + 1] for w in x['worst_windows'][:3]]
        listen += [start for start, _ in regions]

    s = p['silence']
    if max(s['silences_original'], s['silences_normalized']) >= MIN_SILENCES and s['match'] < MIN_SILENCE_MATCH:
        reasons.append(f"pauses: only {s['match']:.0%} line up "
                       f"({s['silences_original']} vs {s['silences_normalized']})")
        listen += s['unmatched_at'][:3]

    t = p.get('transcript')
    if t:
        for c in t['clips']:
            if c['wer'] > MAX_WER and not transcriber_quirk(c):
                reasons.append(f"transcript differs {c['wer']:.0%} in clip at {timestamp(c['start'])}")
                listen.append(c['start'])
    return reasons, sorted(set(round(t) for t in listen))


def transcriber_quirk(c):
    """Whisper sometimes skips or rewords a sentence over tiny audio differences. When
    the waveforms match second by second throughout the clip, that's what happened."""
    return c.get('waveform_r_min') is not None and c['waveform_r_min'] >= 0.5


LABEL_WIDTH = 44
COLUMN_WIDTH = 10


def distribution(label, values, fmt='{:.3f}'):
    values = [v for v in values if v is not None]
    if not values:
        return
    q = np.percentile(values, [0, 1, 50, 99, 100])
    print(f'  {label:<{LABEL_WIDTH}}' + ''.join(f'{fmt.format(v):>{COLUMN_WIDTH}}' for v in q))


def main():
    parser = argparse.ArgumentParser(description='Judge the normalization test results')
    parser.add_argument('results')
    parser.add_argument('--url', default=DEFAULT_URL, help=f'where episodes are published (default {DEFAULT_URL})')
    args = parser.parse_args()
    results = args.results

    def normalized_url(name, at=None):
        return f'{args.url}/normalized/{name}' + (f'#t={round(at)}' if at is not None else '')

    def original_url(name, at=None):
        return f'{args.url}/{name}' + (f'#t={round(at)}' if at is not None else '')

    pairs = read_results(os.path.join(results, 'pairs'))
    transcripts = read_results(os.path.join(results, 'transcripts'))
    for name, t in transcripts.items():
        if name in pairs:
            pairs[name]['transcript'] = t
    names = sorted(pairs, key=natural_key)

    episodes_file = os.path.join(results, 'episodes.txt')
    total = sum(1 for _ in open(episodes_file)) if os.path.exists(episodes_file) else len(names)
    clips = [c for t in transcripts.values() for c in t['clips']]
    print('PROGRESS')
    print(f'  Structural, loudness and content checks: {len(names)}/{total} episodes')
    print(f'  Transcription comparison: {len(transcripts)} episodes, {len(clips)} clips, '
          f'{sum(c["seconds"] for c in clips) / 60:.0f} minutes of audio per version')
    if not names:
        return

    P = [pairs[n] for n in names]
    print(f'\n{"DISTRIBUTIONS":<{LABEL_WIDTH + 2}}'
          + ''.join(f'{h:>{COLUMN_WIDTH}}' for h in ('min', '1%', 'median', '99%', 'max')))
    distribution('Duration change (s)', [p['normalized']['duration'] - p['original']['duration'] for p in P])
    distribution('Time offset between versions (s)', [p['lag_seconds'] for p in P], '{:.4f}')
    distribution('Original loudness (LUFS)', [p['original']['loudness_i'] for p in P], '{:.1f}')
    distribution('Normalized loudness (LUFS)', [p['normalized']['loudness_i'] for p in P], '{:.1f}')
    distribution('Original true peak (dBTP)', [p['original']['true_peak'] for p in P], '{:.1f}')
    distribution('Normalized true peak (dBTP)', [p['normalized']['true_peak'] for p in P], '{:.1f}')
    distribution('Original loudness range (LU)', [p['original']['lra'] for p in P], '{:.1f}')
    distribution('Normalized loudness range (LU)', [p['normalized']['lra'] for p in P], '{:.1f}')
    distribution('Fingerprint similarity', [p['fingerprint']['similarity'] for p in P])
    distribution('Fingerprint worst 30s chunk', [p['fingerprint'].get('chunk_min') for p in P])
    distribution('Waveform correlation, median second', [p['xcorr']['r_median'] for p in P], '{:.4f}')
    distribution('Waveform correlation, 1st-percentile second', [p['xcorr']['r_p1'] for p in P])
    distribution('Waveform correlation, worst second', [p['xcorr']['r_min'] for p in P])
    distribution('Seconds correlating below 0.5', [p['xcorr']['windows_below_0_5'] for p in P], '{:.0f}')
    distribution('Pauses that line up', [p['silence']['match'] for p in P])
    if clips:
        distribution('Transcript word error rate, per clip', [c['wer'] for c in clips])
        identical = sum(c['wer'] == 0 for c in clips)
        quirks = [(t['episode'], c) for t in transcripts.values() for c in t['clips']
                  if c['wer'] > MAX_WER and transcriber_quirk(c)]
        print(f'  {identical}/{len(clips)} clips transcribed identically; {len(quirks)} differ by more '
              f'than {MAX_WER:.0%} only because of the transcriber (the waveforms match throughout):')
        for name, c in quirks:
            print(f'    {name} clip at {timestamp(c["start"])}: {c["wer"]:.0%} of words differ')

    print('\nNEEDS A LISTEN')
    rows, flagged = [], 0
    for name, p in zip(names, P):
        reasons, listen = judge(p)
        if reasons:
            flagged += 1
            print(f'  {name}: ' + '; '.join(reasons))
            print(f'    normalized  {normalized_url(name)}')
            print(f'    original    {original_url(name)}')
            for t in listen[:6]:
                print(f'    {timestamp(t):<11} {normalized_url(name, t)}')
        rows.append({
            'episode': name,
            'normalized_url': normalized_url(name),
            'original_url': original_url(name),
            'flagged': bool(reasons),
            'reasons': '; '.join(reasons),
            'listen_at': ' '.join(timestamp(t) for t in listen),
            'duration_change': round(p['normalized']['duration'] - p['original']['duration'], 3),
            'lag_seconds': p['lag_seconds'],
            'decoder_errors_original': p['original']['decode_complaint_count'],
            'decoder_errors_normalized': p['normalized']['decode_complaint_count'],
            'id3v2_identical': p['tags']['id3v2_identical'],
            'id3v1_identical': p['tags']['id3v1_identical'],
            'loudness_original': p['original']['loudness_i'],
            'loudness_normalized': p['normalized']['loudness_i'],
            'true_peak_original': p['original']['true_peak'],
            'true_peak_normalized': p['normalized']['true_peak'],
            'lra_original': p['original']['lra'],
            'lra_normalized': p['normalized']['lra'],
            'fingerprint_similarity': p['fingerprint']['similarity'],
            'fingerprint_chunk_min': p['fingerprint'].get('chunk_min'),
            'xcorr_median': p['xcorr']['r_median'],
            'xcorr_p1': p['xcorr']['r_p1'],
            'xcorr_min': p['xcorr']['r_min'],
            'xcorr_seconds_below_0_5': p['xcorr']['windows_below_0_5'],
            'silence_match': p['silence']['match'],
            'transcript_max_wer': max((c['wer'] for c in p['transcript']['clips']), default=None)
                                  if p.get('transcript') else None,
        })
    if not flagged:
        print('  None')

    print('\nSPOT-CHECK PICKS (even when nothing is flagged, these are the most changed)')

    def pick(label, key, reverse=False):
        name = sorted(names, key=lambda n: key(pairs[n]), reverse=reverse)[0]
        print(f'  {label:<34} {normalized_url(name)}')

    pick('Turned up the most', lambda p: p['normalized']['loudness_i'] - p['original']['loudness_i'], True)
    pick('Turned down the most', lambda p: p['normalized']['loudness_i'] - p['original']['loudness_i'])
    pick('Most peak limiting', lambda p: p['original']['true_peak'] - p['normalized']['true_peak'], True)
    pick('Most dynamic-range compression', lambda p: p['original']['lra'] - p['normalized']['lra'], True)
    pick('Most uneven gain change', lambda p: p['xcorr']['gain_db_std'], True)
    pick('Lowest waveform correlation', lambda p: p['xcorr']['r_p1'])
    pick('Lowest fingerprint similarity', lambda p: p['fingerprint']['similarity'])
    print(f'  {"Oldest":<34} {normalized_url(names[0])}')
    print(f'  {"Newest":<34} {normalized_url(names[-1])}')
    print('  (The original of each is the same link without /normalized)')

    out = os.path.join(results, 'report.csv')
    with open(out, 'w', newline='') as f:
        writer = csv.DictWriter(f, fieldnames=rows[0].keys())
        writer.writeheader()
        writer.writerows(rows)
    print(f'\n{flagged}/{len(names)} episodes flagged. Every measurement: {out}')


if __name__ == '__main__':
    main()
