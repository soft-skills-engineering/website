#!/usr/bin/env bash
#########################################################################################
#
# Normalize an episode mp3 so it plays at a consistent, comfortable volume.
#
# Usage: ./normalize-audio <input.mp3> <output.mp3>
#
# What does it do?
#   1. Sets the integrated loudness to -16 LUFS (the Apple/Spotify podcast standard),
#      so episodes aren't too quiet and every episode sounds equally loud.
#   2. Reduces the loudness range (big swings between quiet and loud stretches).
#   3. Caps true peaks at -1.5 dBTP in the finished mp3, so nothing clips.
#   4. Removes sub-70 Hz rumble (desk thumps, HVAC), which wastes headroom.
#   5. Preserves the ID3v2 and ID3v1 tags byte-for-byte (title, cover art, chapters, etc.)
#
# How does it work?
#   1. Measure the episode with ffmpeg's loudnorm filter (EBU R128).
#   2. Measure what loudnorm produces from those measurements. When it has to even out
#      a dynamic episode it tends to land below the target, so note how far.
#   3. Apply loudnorm, make up that shortfall with a fixed gain, and catch the few peaks
#      the extra gain pushes too high with a look-ahead limiter. Then encode the mp3.
#   4. Measure the mp3. Encoding overshoots peaks (by over 1 dB on some episodes), and
#      limiting harder lowers the loudness a little, so if either is off target, adjust
#      the limiter and gain and encode again.
#   ffmpeg would rewrite the tags (dropping frames it doesn't understand), so instead
#   the encoded audio is written tag-free and the original tag bytes are copied around it.
#
# Written by Opus-5.5
#
##########################################################################################

set -euo pipefail

TARGET_I=-16    # Integrated loudness, LUFS
TARGET_TP=-1.5  # True peak ceiling of the finished mp3, dBTP
TARGET_LRA=7    # Loudness range, LU (lower = more consistent; speech sounds natural ~5-8)
MAX_LOUDNESS_ERROR=0.5  # LU the finished mp3 may be from TARGET_I
LIMITER_HEADROOM=0.5    # dB below TARGET_TP to set the limiter at first, for mp3 overshoot
MAX_ENCODES=4           # Attempts at getting the mp3 on target
HIGHPASS=highpass=f=70
# mp3 encoding discards the highest frequencies, which raises peaks. Removing them before
# the limiter lets it see (most of) the peaks the mp3 will have. Speech has little up here.
LOWPASS=lowpass=f=16000:poles=2
DEFAULT_BITRATE=128k  # Used only if the source bitrate can't be determined

if [[ $# != 2 ]]; then
  echo "Usage: ./normalize-audio-volume <input.mp3> <output.mp3>" >&2
  exit 1
fi

input_file_path="$1"
output_file_path="$2"

for executable in ffmpeg ffprobe; do
  if ! which "$executable" >/dev/null 2>&1; then
    echo "Cannot find $executable executable. Install it!" >&2
    exit 1
  fi
done

if [ ! -f "$input_file_path" ]; then
  echo "No such file: $input_file_path" >&2
  exit 1
fi

if [ -e "$output_file_path" ] && [ "$input_file_path" -ef "$output_file_path" ]; then
  echo "Output file must be different from the input file" >&2
  exit 1
fi

# Prints "<integrated loudness LUFS> <true peak dBTP>" of a file's audio after the given
# filters (if any)
function measure() {
  local file="$1" filters="${2:+$2,}" output loudness peak
  if ! output=$(ffmpeg -hide_banner -nostats -i "$file" -map 0:a:0 \
                -af "${filters}ebur128=framelog=quiet:peak=true" -f null - 2>&1); then
    echo "$output" >&2
    echo "Failed to measure loudness of $file" >&2
    exit 1
  fi
  loudness=$(echo "$output" | sed -n 's/^ *I: *\([^ ]*\) LUFS$/\1/p' | tail -1)
  peak=$(echo "$output" | sed -n 's/^ *Peak: *\([^ ]*\) dBFS$/\1/p' | tail -1)
  if [[ ! $loudness =~ ^-?[0-9]+(\.[0-9]+)?$ || ! $peak =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then
    echo "Unusable loudness measurement of $file: I='$loudness' TP='$peak'" >&2
    exit 1
  fi
  echo "$loudness $peak"
}

# Prints the result of an arithmetic expression, e.g. calc "-16 - -17.2"
function calc() {
  awk "BEGIN { printf \"%.4f\", $1 }"
}

# Succeeds if a numeric comparison holds, e.g. holds "-1.2 <= -1.5"
function holds() {
  awk "BEGIN { exit !($1) }"
}

# Pass 1: measure
loudnorm="loudnorm=I=$TARGET_I:TP=$TARGET_TP:LRA=$TARGET_LRA"
if ! pass1_output=$(ffmpeg -hide_banner -nostats \
                    -i "$input_file_path" \
                    -map 0:a:0 \
                    -af "$HIGHPASS,$loudnorm:print_format=json" \
                    -f null - \
                    2>&1); then
  echo "$pass1_output" >&2
  echo "Failed to measure loudness of $input_file_path" >&2
  exit 1
fi
stats=$(echo "$pass1_output" | sed -n '/^{/,/^}/p')

function loudnorm_stat() {
  local value
  value=$(echo "$stats" | sed -n "s/.*\"$1\" *: *\"\([^\"]*\)\".*/\1/p")
  # e.g. "-inf" for silent audio, which loudnorm can't correct
  if [[ ! $value =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then
    echo "Unusable loudness measurement $1='$value' for $input_file_path" >&2
    exit 1
  fi
  echo "$value"
}

measured_i=$(loudnorm_stat input_i)
measured_tp=$(loudnorm_stat input_tp)
measured_lra=$(loudnorm_stat input_lra)
measured_thresh=$(loudnorm_stat input_thresh)
target_offset=$(loudnorm_stat target_offset)
measured="measured_I=$measured_i:measured_TP=$measured_tp:measured_LRA=$measured_lra"
measured="$measured:measured_thresh=$measured_thresh:offset=$target_offset"

function probe() {
  ffprobe -v error -select_streams a:0 -show_entries "stream=$1" -of csv=p=0 "$input_file_path"
}

# loudnorm upsamples to 192 kHz internally, so resample back to the source rate
sample_rate=$(probe sample_rate)
if [[ ! $sample_rate =~ ^[0-9]+$ ]]; then
  echo "Cannot determine the sample rate of $input_file_path" >&2
  exit 1
fi

# Size in bytes of the ID3v2 tag(s) at the start of the input file (0 if none)
function id3v2_size() {
  local total=0 header size
  while true; do
    header=($(tail -c +$((total + 1)) "$input_file_path" | head -c 10 | od -An -tu1))
    # Must start with "ID3"
    if [[ ${#header[@]} -lt 10 || ${header[0]} != 73 || ${header[1]} != 68 || ${header[2]} != 51 ]]; then
      break
    fi
    size=$(( (header[6] << 21) | (header[7] << 14) | (header[8] << 7) | header[9] ))
    (( header[5] & 0x10 )) && size=$((size + 10))  # Footer present
    total=$((total + 10 + size))
  done
  echo $total
}

# Whether the input file ends with a 128-byte ID3v1 tag
function has_id3v1() {
  # Strip null bytes, which bash can't hold in a variable (and would warn about)
  [ "$(tail -c 128 "$input_file_path" | head -c 3 | tr -d '\0')" = "TAG" ]
}

# Read a big-endian unsigned integer of $2 bytes at byte offset $1 of the input file
function read_uint() {
  local value=0 byte
  for byte in $(tail -c +$(($1 + 1)) "$input_file_path" | head -c "$2" | od -An -tu1); do
    value=$(( (value << 8) | byte ))
  done
  echo $value
}

# The LAME VBR quality ("-V" level, 0-9) of the input file, or nothing if it isn't VBR.
# VBR files start with a "Xing" header frame, whose optional quality field LAME sets to
# 100 - 10*V - q.
function vbr_quality() {
  local first_frame xing flags offset quality
  first_frame=$(id3v2_size)
  xing=$(tail -c +$((first_frame + 1)) "$input_file_path" | head -c 64 | LC_ALL=C grep -abo Xing | head -1 | cut -d: -f1 || true)
  [ -n "$xing" ] || return 0
  offset=$((first_frame + xing + 4))
  flags=$(read_uint $offset 4)
  offset=$((offset + 4))
  (( flags & 1 )) && offset=$((offset + 4))    # Frame count
  (( flags & 2 )) && offset=$((offset + 4))    # Byte count
  (( flags & 4 )) && offset=$((offset + 100))  # Seek table
  quality=2  # LAME's default
  if (( flags & 8 )); then
    quality=$(( (100 - $(read_uint $offset 4)) / 10 ))
    (( quality >= 0 && quality <= 9 )) || quality=2
  fi
  echo $quality
}

# Encode the way the source was encoded: same VBR quality, or same constant bitrate
vbr_quality=$(vbr_quality)
if [ -n "$vbr_quality" ]; then
  encoding=(-q:a "$vbr_quality")
else
  bitrate=$(probe bit_rate)
  [[ $bitrate =~ ^[0-9]+$ ]] || bitrate=$DEFAULT_BITRATE
  encoding=(-b:a "$bitrate")
fi

audio_only_temp_file_path=""
output_temp_file_path=""
function cleanup() {
  rm -f "$audio_only_temp_file_path" "$output_temp_file_path"
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP  # Make sure cleanup runs when interrupted

audio_only_temp_file_path=$(mktemp "${TMPDIR:-/tmp}/normalize-audio-volume.XXXXXX")
output_temp_file_path=$(mktemp "${TMPDIR:-/tmp}/normalize-audio-volume.XXXXXX")

# Pass 2: how far short of the target loudness loudnorm lands
normalized="$HIGHPASS,$loudnorm:$measured"
measurement=$(measure "$input_file_path" "$normalized,aresample=$sample_rate")
read -r loudnorm_i _ <<< "$measurement"
gain=$(calc "$TARGET_I - $loudnorm_i")

# Pass 3: apply, limiting peaks to $1 dBTP, and encode (bare audio frames, with no tags).
# Uses the current $gain. loudnorm outputs 192 kHz, so limiting before resampling also
# catches the peaks between samples. The limiter's latency compensation keeps the audio
# in sync with the original.
function encode() {
  local limit
  limit=$(calc "10 ^ ($1 / 20)")
  ffmpeg -hide_banner -nostats -loglevel error -y -i "$input_file_path" \
      -af "$normalized,volume=${gain}dB,$LOWPASS,alimiter=limit=$limit:level=disabled:latency=enabled,aresample=$sample_rate" \
      -map 0:a:0 -map_metadata -1 -map_chapters -1 -fflags +bitexact \
      -id3v2_version 0 -write_id3v1 0 \
      -c:a libmp3lame "${encoding[@]}" \
      -f mp3 "$audio_only_temp_file_path"
  if [ ! -s "$audio_only_temp_file_path" ]; then
    echo "ffmpeg produced no audio for $input_file_path" >&2
    exit 1
  fi
}

# Pass 4: measure the mp3, and re-encode with a corrected limit and gain if it's off target
ceiling=$(calc "$TARGET_TP - $LIMITER_HEADROOM")
for attempt in $(seq "$MAX_ENCODES"); do
  encode "$ceiling"
  measurement=$(measure "$audio_only_temp_file_path")
  read -r final_i final_tp <<< "$measurement"
  if holds "$final_tp <= $TARGET_TP && $final_i >= $TARGET_I - $MAX_LOUDNESS_ERROR && $final_i <= $TARGET_I + $MAX_LOUDNESS_ERROR"; then
    break
  fi
  if (( attempt == MAX_ENCODES )); then
    echo "Warning: $input_file_path is $final_i LUFS, $final_tp dBTP after $MAX_ENCODES encodes" \
         "(target $TARGET_I LUFS, $TARGET_TP dBTP)" >&2
    break
  fi
  # Lower the limit by the overshoot, plus a little more so the next try lands under
  if holds "$final_tp > $TARGET_TP"; then
    ceiling=$(calc "$ceiling - ($final_tp - $TARGET_TP) - 0.2")
  fi
  gain=$(calc "$gain + $TARGET_I - $final_i")
done

# Reassemble: original ID3v2 tag + new audio + original ID3v1 tag
id3v2_bytes=$(id3v2_size)
{
  head -c "$id3v2_bytes" "$input_file_path"
  cat "$audio_only_temp_file_path"
  if has_id3v1; then
    tail -c 128 "$input_file_path"
  fi
} > "$output_temp_file_path"

# mktemp creates files as 0600; give the output the usual permissions for a new file
chmod "$(printf '%o' $(( 0666 & ~$(umask) )))" "$output_temp_file_path"
mv -f "$output_temp_file_path" "$output_file_path"
