#!/usr/bin/env python3
#########################################################################################
#
# Check that normalize-audio-volume kept one episode's content intact, and pass or fail.
#
# Usage: ./check-normalized-audio-volume [--transcript-check-level LEVEL]
#                                        <original.mp3> [normalized.mp3]
#
# Compares the normalized episode with its original: structure, tags, loudness,
# fingerprint, waveform and pause comparisons (see audio-qa/measure.py), and speech-to-text
# of matching clips from both (see audio-qa/transcripts.py), judged by the thresholds in
# audio-qa/judge.py. Without [normalized.mp3], normalizes a temporary copy of the original
# with ./normalize-audio-volume and checks that.
#
# --transcript-check-level controls how much of the episode is transcribed (the other
# checks always run). Times are the whole check, for a 33 minute episode on 4 CPUs:
#   complete  The whole episode, as back-to-back one-minute clips (default, ~7.5 minutes)
#   8x120     8 two-minute clips spread through the episode (~5 minutes)
#   4x60      4 one-minute clips (~2.5 minutes)
#   2x30      2 thirty-second clips (~1.5 minutes)
#   skip      No transcription (~50 seconds)
#
# Exit status: 0 if it passes, 1 if it fails, 2 if it couldn't check.
#
# Needs numpy and faster-whisper from requirements.txt, so run it with ./venv activated
# (./upload does). The first run downloads the transcription model (~500 MB).
#
##########################################################################################

import os
import sys

here = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(here, 'audio-qa'))

import argparse  # noqa: E402
import shutil  # noqa: E402
import subprocess  # noqa: E402
import tempfile  # noqa: E402

import judge  # noqa: E402
from common import timestamp  # noqa: E402
from measure import measure_pair  # noqa: E402
from transcripts import compare_transcripts, full_clips, sample_clips  # noqa: E402

TRANSCRIPT_CHECK_LEVELS = ('complete', '8x120', '4x60', '2x30', 'skip')


def fmt(value, spec):
    return '?' if value is None else format(value, spec)


def show(p):
    o, n = p['original'], p['normalized']
    tags, fp, x, s = p['tags'], p['fingerprint'], p['xcorr'], p['silence']

    def row(label, original, normalized, limit=''):
        print(f'  {label:<30}{original:>12}{normalized:>12}   {limit}')

    row('', 'original', 'normalized')
    row('Duration', timestamp(o['duration']), timestamp(n['duration']),
        f"changed {n['duration'] - o['duration']:+.3f}s (limit ±{judge.MAX_DURATION_CHANGE}s)")
    row('Loudness (LUFS)', fmt(o['loudness_i'], '.1f'), fmt(n['loudness_i'], '.1f'),
        f'target {judge.TARGET_I} ±{judge.MAX_LOUDNESS_MISS}')
    row('True peak (dBTP)', fmt(o['true_peak'], '.1f'), fmt(n['true_peak'], '.1f'),
        f'max {judge.MAX_TRUE_PEAK}')
    row('Loudness range (LU)', fmt(o['lra'], '.1f'), fmt(n['lra'], '.1f'))
    row('Decoder errors', str(o['decode_complaint_count']), str(n['decode_complaint_count']),
        'no more than the original')
    print()
    print(f"  {'ID3v2 tag':<30}{'identical' if tags['id3v2_identical'] else 'CHANGED'} "
          f"({tags['id3v2_bytes']} bytes)")
    print(f"  {'ID3v1 tag':<30}"
          + ('CHANGED' if not tags['id3v1_identical'] else 'identical' if tags['id3v1_present'] else 'none'))
    print(f"  {'Time offset between versions':<30}{p['lag_seconds']:.4f}s")
    print(f"  {'Fingerprint similarity':<30}{fp['similarity']:.3f} overall (min {judge.MIN_FP_SIMILARITY}), "
          f"worst 30s {fmt(fp.get('chunk_min'), '.3f')} (min {judge.MIN_FP_CHUNK})")
    print(f"  {'Waveform correlation':<30}median {x['r_median']:.4f}, 1st percentile {x['r_p1']:.3f} "
          f"(min {judge.MIN_XCORR_P1}), {x['windows_below_0_5']} of {x['windows_compared']} "
          f"seconds don't match (max {judge.MAX_XCORR_DROPOUTS})")
    print(f"  {'Pauses that line up':<30}{s['match']:.0%} of {s['silences_original']} vs "
          f"{s['silences_normalized']} (min {judge.MIN_SILENCE_MATCH:.0%})")
    if 'transcript' not in p:
        print(f"  {'Transcripts':<30}not checked")
        return
    clips = p['transcript']['clips']
    worst = max(clips, key=lambda c: c['wer'])
    minutes = sum(c['seconds'] for c in clips) / 60
    print(f"  {'Transcripts':<30}{len(clips)} clips ({minutes:.0f} min), worst {worst['wer']:.0%} of words "
          f"differ at {timestamp(worst['start'])} (max {judge.MAX_WER:.0%} per clip)")
    for c in clips:
        if c['wer'] > judge.MAX_WER:
            quirk = ' (transcriber quirk: the waveforms match)' if judge.transcriber_quirk(c, p) else ''
            print(f"  {'  clip at ' + timestamp(c['start']):<30}{c['wer']:.0%} of {c['words']} words differ{quirk}")


def main():
    parser = argparse.ArgumentParser(
        prog='./check-normalized-audio-volume',
        description='Check that normalize-audio-volume kept one episode\'s content intact.')
    parser.add_argument('--transcript-check-level', choices=TRANSCRIPT_CHECK_LEVELS, default='complete',
                        help='how much of the episode to transcribe and compare: complete (the default), '
                             'skip, or <clips>x<seconds>; see the top of this script')
    parser.add_argument('original')
    parser.add_argument('normalized', nargs='?')
    try:
        args = parser.parse_args()
    except SystemExit as e:
        sys.exit(0 if e.code == 0 else 2)  # Bad usage means "couldn't check", not "failed"

    if not shutil.which('ffmpeg'):
        print('Cannot find ffmpeg executable. Install it!', file=sys.stderr)
        sys.exit(2)
    original = args.original
    for path in filter(None, [args.original, args.normalized]):
        if not os.path.isfile(path):
            print(f'No such file: {path}', file=sys.stderr)
            sys.exit(2)

    with tempfile.TemporaryDirectory(prefix='check-normalized-audio-volume.') as workdir:
        if args.normalized:
            normalized = args.normalized
        else:
            normalized = os.path.join(workdir, os.path.basename(original))
            print(f'Normalizing {original} into a temporary copy', flush=True)
            normalizer = os.path.join(here, 'normalize-audio-volume')
            if subprocess.run([normalizer, original, normalized]).returncode != 0:
                print(f'FAIL: {normalizer} failed on {original}')
                sys.exit(1)

        print(f'Checking {normalized} against original {original} (--transcript-check-level {args.transcript_check_level})', flush=True)
        try:
            p = measure_pair(original, normalized)
            level, duration = args.transcript_check_level, p['original']['duration']
            if level != 'skip':
                if level == 'complete':
                    clips = full_clips(duration)
                else:
                    count, seconds = map(int, level.split('x'))
                    clips = sample_clips(duration, count, seconds)
                p['transcript'] = compare_transcripts(original, normalized, clips, p['lag_seconds'])
        except (RuntimeError, ImportError) as e:
            print(e, file=sys.stderr)
            sys.exit(2)

    print()
    show(p)
    reasons, listen = judge.judge(p)
    print()
    if not reasons:
        print(f"PASS: {p['episode']}")
        return
    print(f"FAIL: {p['episode']}")
    for reason in reasons:
        print(f'  - {reason}')
    if listen:
        print('  Listen at: ' + ', '.join(timestamp(t) for t in listen[:10]))
    sys.exit(1)


if __name__ == '__main__':
    main()
