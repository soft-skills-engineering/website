#!/usr/bin/env bash
#########################################################################################
#
# Check that normalize-audio-volume kept every episode's content intact.
#
# Usage: ./run-all <originals-dir> <normalized-dir> <results-dir> [jobs]
#
# Compares each mp3 in <normalized-dir> with the same-named file in <originals-dir>:
#   1. ./check-pair on every episode: structure, tags, loudness, fingerprint, waveform
#      and pause comparisons
#   2. ./check-transcripts on a sample: speech-to-text of matching clips from both
#   3. ./report: which episodes need a listen, and where
#
# Runs [jobs] episodes at a time (default: one per CPU) at the lowest CPU and IO
# priority, so the rest of the server keeps priority. Re-running skips finished work.
# Watch progress from another terminal with: ./report <results-dir>
#
# Uses ../venv (creating it if needed), adding faster-whisper from
# requirements-transcripts.txt to it. The first run downloads the transcription
# model (~500 MB) into ./models.
#
##########################################################################################

set -euo pipefail

if [[ $# -lt 3 || $# -gt 4 ]]; then
  echo "Usage: ./run-all <originals-dir> <normalized-dir> <results-dir> [jobs]"
  exit 1
fi

originals="$1"
normalized="$2"
results="$3"
jobs="${4:-$(nproc)}"
here="$(cd "$(dirname "$0")" && pwd)"
venv="$here/../venv"
python="$venv/bin/python"

if ! which ffmpeg >/dev/null 2>&1; then
  echo "Cannot find ffmpeg executable. Install it!"
  exit 1
fi

[ -x "$python" ] || virtualenv "$venv" --python=python3
"$python" -m pip install -q -r "$here/../requirements.txt" -r "$here/requirements-transcripts.txt"

mkdir -p "$results/pairs"
for path in "$normalized"/*.mp3; do
  name="$(basename "$path")"
  [ -f "$originals/$name" ] && echo "$name"
done > "$results/episodes.txt"

low_priority=(nice -n 19 ionice -c3)

echo "Phase 1/2: checking $(wc -l < "$results/episodes.txt") episodes, $jobs at a time"
xargs -a "$results/episodes.txt" -d '\n' -P "$jobs" -n 1 \
  "${low_priority[@]}" "$python" "$here/check-pair" "$originals" "$normalized" "$results/pairs"

echo "Phase 2/2: comparing transcripts"
"${low_priority[@]}" "$python" "$here/check-transcripts" "$originals" "$normalized" "$results" --jobs "$jobs"

echo
"$python" "$here/report" "$results"
